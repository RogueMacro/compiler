// file descriptors:
// stdout = 1

package std;

mod fmt;
mod syscall;

memory arena: *i8;
memory arena_size: u64;
memory arena_offset: u64;
memory arena_init: bool;

fn strlen(buf: *char) -> i64 {
  ptr := buf;
  while *ptr != '\0' {
    i := ptr as i64;
    i = i + 1;
    ptr = i as *char;
  }

  start := buf as i64;
  end := ptr as i64;
  return end - start;
}

fn itos(number: i64) -> *char {
  _n := number;
  n_chars := 0u64;

  negative := false;
  if number < 0 {
    negative = true;
    n_chars += 1;
    _n = -_n;
  }

  n := _n;
  while n > 0 {
      n_chars += 1;
      n /= 10;
  }

  str := std::alloc(n_chars + 1) as *char;
  i := n_chars - 1;
  n = _n;

  while n > 0 {
      c := n % 10 + 48;
      str[i] = (c as i8) as char;

      n /= 10;
      i -= 1;
  }

  if negative {
    str[0] = '-';
  }

  if number == 0 {
    str[0] = '0';
  }

  str[n_chars + 1] = '\0';
  return str;
}

fn alloc(bytes: u64) -> *i8 {
  if !arena_init || bytes > arena_size - arena_offset {
    arena = std::syscall::mmap(0 as *(), 4096, 3, 4098, -1, 0);
    arena_size = 4096u64;
    arena_offset = 0u64;
    arena_init = true;
  }

  ptr := (arena as u64 + arena_offset) as *i8;
  arena_offset += bytes;
  return ptr;
}


struct String {
  data: *char,
  length: u64,
  capacity: u64
}

impl String {
  fn from(str: *char) -> *std::String {
    string := std::alloc(sizeof(std::String)) as *std::String;

    len := std::strlen(str) as u64;
    data := std::alloc(len) as *char;
    i := 0u64;
    while i < len {
      data[i] = str[i];
      i += 1;
    }

    string.data = data;
    string.length = len;
    string.capacity = len;
    return string;
  }
}

fn max(a: u64, b: u64) -> u64 {
    if a > b {
        return a;
    }
    
    return b;
}

struct Vec {
    data: *i64,
    length: u64,
    capacity: u64
}

impl Vec {
    fn new() -> *Vec {
        return [Vec] { data: 0 as *i64, length: 0, capacity: 0 };
    }

    fn push_i64(self: *Vec, item: i64) {
        if self.length == self.capacity {
            old := self.data;
            self.capacity = max(self.capacity * 2, 10u64);
            self.data = std::alloc(self.capacity * sizeof(i64)) as *i64;
            if (old as i64) != 0 {
                copy(old as *i8, self.data as *i8, self.length * sizeof(i64));
            }
        }

        std::fmt::print(String::from("vector push "));
        std::fmt::print(String::from(itos(item)));
        std::fmt::print(String::from(" at index "));
        std::fmt::print(String::from(itos(self.length as i64)));
        std::fmt::printc('\n');

        self.data[self.length] = item;
        self.length += 1;
    }
}

fn copy(src: *i8, dest: *i8, len: u64) {
    i := 0u64;
    while i < len {
        dest[i] = src[i];
    }
}
